{
  "name": "rp-doces",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:functions",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "lint": "biome check .",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "audit:home": "playwright test --grep=@home-visual-audit --workers=1 --output=test-results/home-visual-audit",
    "typecheck:home-audit": "tsc --noEmit -p tsconfig.home-visual-audit.json",
    "test:cached": "node scripts/run-tests-cached.mjs",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "db:migrations:check": "node scripts/check-d1-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply rp-doces-db --local",
    "db:seed:local": "wrangler d1 execute rp-doces-db --local --file=./seed/products.sql",
    "smoke:prod": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "motion": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.1",
    "miniflare": "^3.20250718.3",
    "prettier": "3.9.9",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "npm": ">=11.17.0"
  },
  "allowScripts": {
    "esbuild@0.21.5 || 0.28.2": false,
    "workerd@1.20250718.0 || 1.20261006.1": false,
    "fsevents@2.3.3": false
  }
}
