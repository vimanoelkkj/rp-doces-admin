{
  "name": "rp-doces",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:functions",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:cached": "node scripts/run-tests-cached.mjs",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply rp-doces-db --local",
    "db:seed:local": "wrangler d1 execute rp-doces-db --local --file=./seed/products.sql"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "motion": "^13.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wrangler": "^3.78.0"
  }
}
