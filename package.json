{
  "name": "rp-doces",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix admin ci",
    "dev": "wrangler pages dev public",
    "dev:test": "node scripts/setup-local-test.mjs --serve",
    "test:local:setup": "node scripts/setup-local-test.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin:dev": "npm --prefix admin run dev",
    "admin:test": "npm --prefix admin test",
    "admin:build": "npm --prefix admin run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:frontend": "node scripts/audit-frontend-bundling.mjs",
    "build:storefront:experiment": "node scripts/build-storefront-experiment.mjs",
    "preview:storefront:bundle": "node scripts/build-storefront-preview.mjs",
    "schema:generate": "node scripts/generate-schema-full.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "deploy:preview": "wrangler pages deploy public --project-name=rp-doces",
    "deploy:production": "node scripts/deploy-production.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2"
  }
}
